# ==============================================================================
# Talk-With-Me Monorepo Master Environment Variables
# Copy to .env in root or backend/ and configure for your environment
# ==============================================================================

# Application Configuration
APP_NAME="Talk-With-Me API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Service Exposed Ports
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talkwithme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0

# Frontend URL (dùng để sinh link reset mật khẩu trong email và cấu hình CORS)
# Local: "http://localhost:4200" | Docker: "http://localhost" | Vercel Dev: "https://talkwithmee-dev.vercel.app" | Vercel Prod: "https://talkwithmee.vercel.app"
FRONTEND_URL="http://localhost:4200"

# JWT & Auth Security
JWT_SECRET_KEY="change-me-in-production-use-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_TOKEN_VERIFIER="real"

# Email Provider Configuration
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_TLS=True

# Azure AI Speech (Unified STT + Pronunciation Assessment)
SPEECH_ASSESSMENT_PROVIDER="azure_sdk"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"
AZURE_SPEECH_LANGUAGE="en-US"

# Text-to-Speech
TTS_PROVIDER="azure"

# LLM Provider (gemini | groq | cerebras | openrouter | openai)
# Khuyên dùng Groq (llama-3.3-70b-versatile / llama-3.1-8b-instant) hoặc Cerebras để có tốc độ cao (~200ms) và quota lớn
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
LLM_BASE_URL=""
LLM_FALLBACK_PROVIDER=""
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""

# Scoring Engine & CEFR Model
SCORING_FORMULA_VERSION="2.0.0"
CEFR_MODEL_VERSION="cefr-est-1.0.0"
