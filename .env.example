# ==============================================================================
# Talk-With-Me Monorepo Master Environment Variables
# Copy to .env in root or backend/ and configure for your environment
# ==============================================================================

# Application Configuration
APP_NAME="Talk-With-Me API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Service Exposed Ports
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talkwithme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0

# Frontend URL (dùng để sinh link reset mật khẩu trong email và cấu hình CORS)
# Local: "http://localhost:4200" | Docker: "http://localhost" | Vercel Dev: "https://talkwithmee-dev.vercel.app" | Vercel Prod: "https://talkwithmee.vercel.app"
FRONTEND_URL="http://localhost:4200"

# JWT & Auth Security
JWT_SECRET_KEY="change-me-in-production-use-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=""
# "fake" cho môi trường test/dev, "real" hoặc "google" khi chạy thật
GOOGLE_TOKEN_VERIFIER="fake"

# Email Provider Configuration
# "fake" (chỉ log ra console) hoặc "smtp" (gửi email thật)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_TLS=True
