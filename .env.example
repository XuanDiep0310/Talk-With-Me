# ==============================================================================
# Talk-With-Me Monorepo Master Environment Variables
# Copy to .env in root or backend/ and configure for your environment
# ==============================================================================

# Application Configuration
APP_NAME="Talk-With-Me API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Service Exposed Ports
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talkwithme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0

# Frontend Configuration
FRONTEND_API_URL="http://localhost:8000/api/v1"
