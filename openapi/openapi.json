        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Fullname"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "title": "Password"
          },
          "termsAccepted": {
            "type": "boolean",
            "title": "Termsaccepted"
          }
        },
        "type": "object",
        "required": [
          "email",
          "fullName",
          "password",
          "termsAccepted"
        ],
        "title": "RegisterRequest"
