          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "fullName",
          "createdAt"
        ],
        "title": "MeResponse"
      },
