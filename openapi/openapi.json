        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "title": "Newpassword"
          }
        },
        "type": "object",
        "required": [
          "token",
          "newPassword"
        ],
        "title": "ResetPasswordRequest"
      },
